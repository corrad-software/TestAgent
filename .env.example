# ─── TestAgent Configuration ──────────────────────────────────────────────────

# Anthropic API Key (optional — only needed for AI assertions & failure analysis)
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Server port (default: 4000)
PORT=4000

# JWT secret (change this in production!)
JWT_SECRET=testagent-dev-secret-change-in-prod

# SQLite file URL for Prisma migrate & local fallback (must start with file:).
# If your host sets DATABASE_URL to MySQL (e.g. Coolify), leave DATABASE_URL alone and use SQLITE_DATABASE_URL for SQLite.
DATABASE_URL="file:./data/testAgent.db"
# SQLITE_DATABASE_URL="file:./data/testAgent.db"
